   "source": [
    "t = int(time.strftime('%H'))\n",
    "if 5 <= t < 12:\n",
    "    print(\"Good Morning!\")\n",
    "elif 12 <= t < 17:\n",
    "    print(\"Good Afternoon!\")\n",
    "elif 17 <= t < 21:\n",
    "    print(\"Good Evening!\")\n",
    "else:\n",
    "    print(\"Good Night!\")"
   ]
  }
