   "source": [
    "num = int(input(\"Enter the value of num: \"))\n",
    "print(\"The value of num: \",num)\n",
    "if (num < 0):\n",
    "  print(\"Number is negative.\")\n",
    "elif (num == 0):\n",
    "  print(\"Number is Zero.\")\n",
    "elif (num == 999):\n",
    "  print(\"Number is Special.\")\n",
    "else:\n",
    "  print(\"Number is positive.\")\n",
    "\n",
    "print(\"I am happy now\")"
   ]
  }
